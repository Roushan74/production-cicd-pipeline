{
  "name": "production-cicd-api",
  "version": "1.0.0",
  "description": "Task API for a production-style CI/CD pipeline project",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "test": "jest --runInBand",
    "test:coverage": "jest --runInBand --coverage",
    "lint": "eslint ."
  },
  "jest": {
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    }
  },
  "keywords": [
    "nodejs",
    "express",
    "devops",
    "cicd"
  ],
  "author": "Roushan",
  "license": "MIT",
  "dependencies": {
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "supertest": "^7.3.0"
  }
}
